# Copy this file to .env (do not commit .env) and fill values as needed.

# Mercado Pago access token (leave empty to run in simulation mode)
MP_ACCESS_TOKEN=

# Flask session secret key
SECRET_KEY=

# Static PIX key (CNPJ) used for fallback PIX generation
CHAVE_PIX_ILUMINA=

# Debug (1 = on, 0 = off)
FLASK_DEBUG=0

# Base URL used to generate public links (production domain)
BASE_URL=

# Admin panel credentials
ADMIN_USER=admin
ADMIN_PASS_HASH=

# Public WhatsApp destination number (digits only: DDI+DDD+Numero)
WHATSAPP_ILUMINA=554588244623

# Private settings (not shown on the public site)
SEDE_MODO_ATENDIMENTO=Ambos
SEDE_ENDERECO=

